extends layout

block content
  h1= title
  
  div(class="container-fluid")
    div(class="row m-1")
      each item in results
        div(class="col-sm-2 m-1" style="border: 1px solid #dee2e6; border-radius: 5px; padding: 15px;")
          p **Kind:** #{item.kind}
          p **Wings:** #{item.wings}
          p **Teeth:** #{item.teeth}